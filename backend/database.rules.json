{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "students": {
        ".read": "auth != null && root.child('users/admins').child(auth.uid).exists()",
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || root.child('users/admins').child(auth.uid).exists())",
          "isActive": {
            ".write": "auth != null && root.child('users/admins').child(auth.uid).exists()"
          },
          ".write": "auth != null && (auth.uid === $uid || root.child('users/admins').child(auth.uid).exists())"
        }
      },
      "drivers": {
        ".read": "auth != null && root.child('users/admins').child(auth.uid).exists()",
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || root.child('users/admins').child(auth.uid).exists())",
          "status": {
            ".write": "auth != null && (auth.uid === $uid || root.child('users/admins').child(auth.uid).exists())"
          },
          "approvalStatus": {
            ".write": "auth != null && root.child('users/admins').child(auth.uid).exists()"
          },
          "assignedShuttleId": {
            ".write": "auth != null && root.child('users/admins').child(auth.uid).exists()"
          },
          ".write": "auth != null && (auth.uid === $uid || root.child('users/admins').child(auth.uid).exists())"
        }
      },
      "admins": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false
        }
      }
    },

    "shuttles": {
      ".read": "auth != null",
      "$shuttleId": {
        "currentLocation": {
          ".write": "auth != null && root.child('users/drivers').child(auth.uid).child('assignedShuttleId').val() === $shuttleId && root.child('users/drivers').child(auth.uid).child('approvalStatus').val() === 'approved'"
        },
        "availableSeats": {
          ".write": "auth != null && root.child('users/drivers').child(auth.uid).child('assignedShuttleId').val() === $shuttleId && root.child('users/drivers').child(auth.uid).child('approvalStatus').val() === 'approved'"
        },
        "tripStatus": {
          ".write": "auth != null && root.child('users/drivers').child(auth.uid).child('assignedShuttleId').val() === $shuttleId && root.child('users/drivers').child(auth.uid).child('approvalStatus').val() === 'approved'"
        },
        ".write": "auth != null && root.child('users/admins').child(auth.uid).exists()"
      }
    },

    "routes": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users/admins').child(auth.uid).exists()"
    },

    "schedules": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users/admins').child(auth.uid).exists()"
    },

    "notifications": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users/admins').child(auth.uid).exists()"
    },

    "trip_history": {
      ".read": "auth != null && root.child('users/admins').child(auth.uid).exists()",
      "$tripId": {
        ".write": "auth != null && (root.child('users/admins').child(auth.uid).exists() || root.child('users/drivers').child(auth.uid).child('approvalStatus').val() === 'approved')"
      }
    },

    "match_requests": {
      ".read": "auth != null && root.child('users/admins').child(auth.uid).exists()",
      "$requestId": {
        ".read": "auth != null && (data.child('studentId').val() === auth.uid || root.child('users/admins').child(auth.uid).exists())",
        ".write": "auth != null && root.child('users/students').child(auth.uid).exists() && ((!data.exists() && newData.child('studentId').val() === auth.uid) || (data.exists() && data.child('studentId').val() === auth.uid))"
      }
    },

    "feedback": {
      ".read": "auth != null && root.child('users/admins').child(auth.uid).exists()",
      "$feedbackId": {
        ".write": "auth != null && (newData.child('studentId').val() === auth.uid || (data.exists() && data.child('studentId').val() === auth.uid))"
      }
    },

    "settings": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users/admins').child(auth.uid).exists()"
    }
  }
}
